<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:weightSum="14"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:id="@+id/llBack"
            android:gravity="center">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="25dp"
                android:contentDescription="Regresar"
                android:src="@drawable/ic_back"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/robotoregular"
                android:text="Atras"
                android:textColor="@color/titulo_pantalla_general"
                android:textSize="20dp"
                android:layout_centerInParent="true"/>


        </LinearLayout>



        <TextView
            android:id="@+id/tvTituloFormato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/robotobold"
            android:text="Inspeción 100 horas"
            android:textColor="@color/titulo_pantalla_general"
            android:textSize="25dp"
            android:layout_centerInParent="true"/>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_centerInParent="true"
            android:layout_alignParentRight="true"
            android:layout_marginTop="5dp"
            android:layout_marginRight="20dp">




            <ImageView
                android:id="@+id/btnPdf"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/icon_pdf"
                android:layout_marginRight="30dp"/>

            <TextView
                android:id="@+id/tvPaginaFormato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/robotoregular"
                android:text=""
                android:textColor="@color/titulo_pantalla_general"
                android:textSize="17dp" />



        </LinearLayout>






    </RelativeLayout>




    <FrameLayout
        android:id="@+id/containerViewHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="1dp"
        android:background="@color/white">

        <com.helisur.helisurapp.domain.util.ViewPagerNoSwipeable
            android:id="@+id/viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </com.helisur.helisurapp.domain.util.ViewPagerNoSwipeable>
    </FrameLayout>



</LinearLayout>