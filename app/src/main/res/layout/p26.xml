<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="0dp">

        <!-- ENCABEZADO SUPERIOR (Logo dentro de contenedor con bg_cell_row + códigos + página) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <!-- CONTENEDOR DEL LOGO CON FONDO bg_cell_row -->
            <LinearLayout
                android:id="@+id/logoContainer"
                android:layout_width="wrap_content"
                android:layout_height="90dp"
                android:background="@drawable/bg_cell_row"
                android:padding="6dp"
                android:layout_marginRight="-1dp"
                android:orientation="vertical">

                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imgLogoHelisur"
                    android:layout_width="120dp"
                    android:layout_height="48dp"
                    android:src="@drawable/logo_helisur_color"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/untitled" />

                <TextView
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="------ OMA N41 ------"
                    android:textSize="8sp"
                    android:textColor="@color/titulo_pantalla_general"
                    android:gravity="center"
                    android:layout_marginTop="-10dp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:text="PROGRAMA DE MANTENIMIENTO Mi-171"
                    android:textSize="8sp"
                    android:textColor="@color/dark_grey"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Bloque de códigos / revisión / fecha -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="0dp">

                <!-- Fila: CÓDIGO + PÁGINA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:background="@drawable/bg_cell_row"
                    android:padding="6dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CÓDIGO: PM-022"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"/>
                </LinearLayout>

                <!-- Fila: EDITADO / REVISIÓN / FECHA DE REVISIÓN -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:layout_marginTop="-1dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_cell_row"
                        android:padding="6dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EDITADO:"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:textColor="@color/dark_grey"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="15 Jul 2024"
                            android:textSize="11sp"
                            android:textColor="@color/third"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_cell_row"
                        android:padding="6dp"
                        android:layout_marginLeft="-1dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="REVISIÓN:"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:textColor="@color/dark_grey"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="08"
                            android:textSize="11sp"
                            android:textColor="@color/third"/>
                    </LinearLayout>


                </LinearLayout>
            </LinearLayout>
        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_header"
            android:gravity="center"
            android:padding="0dp"
            android:layout_marginBottom="-1dp"
            android:layout_marginTop="8dp"
            android:weightSum="6">



            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:text="INSPECCIÓN PERIÓDICA DE 100 ± 10 HORA"
                android:padding="8dp"
                android:textStyle="bold"
                android:textSize="12sp"
                android:gravity="center"
                android:textColor="@color/dark_grey" />


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:orientation="vertical"
                android:layout_marginLeft="-1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="5">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="Matrícula"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:background="@drawable/bg_table_header" />


                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text=""
                        android:textStyle="normal"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:background="@drawable/bg_cell"
                        android:layout_marginLeft="-1dp"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="5"
                    android:layout_marginTop="-1dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="TSN / TSO"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:background="@drawable/bg_table_header" />


                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text=""
                        android:textStyle="normal"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:background="@drawable/bg_cell"
                        android:layout_marginLeft="-1dp"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="5"
                    android:layout_marginTop="-1dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="N° OT"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:background="@drawable/bg_table_header" />


                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:text=""
                        android:textStyle="normal"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:background="@drawable/bg_cell"
                        android:layout_marginLeft="-1dp"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="5"
                    android:layout_marginTop="-1dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:text="Fecha"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:gravity="center"
                        android:background="@drawable/bg_table_header" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.8"
                        android:text="Firma Ejecutor"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/dark_grey"
                        android:layout_marginLeft="-1dp"
                        android:background="@drawable/bg_table_header" />


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.8"
                        android:text="Insp. en Proc. / RII"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/dark_grey"
                        android:layout_marginLeft="-1dp"
                        android:background="@drawable/bg_table_header" />




                </LinearLayout>





            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_cell_row"
            android:gravity="center"
            android:padding="0dp"
            android:layout_marginBottom="-1dp"
            android:layout_marginTop="-1dp"
            android:weightSum="6">



            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="3"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="6"
                android:layout_marginTop="0dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="49"
                    android:padding="8dp"
                    android:textStyle="normal"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:textColor="@color/dark_grey" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="5"
                    android:layout_height="wrap_content"
                    android:text="Realice las coordinaciones con la tripulación para que se efectúe las
pruebas en tierra de motores, según Formato PM-318.
Nota:\n
1. El mecánico firmará para validar que realizó las
coordinaciones necesarias.\n
2. El Inspector en Procesos firmará dando fe de que se
efectuaron las pruebas."
                    android:padding="8dp"
                    android:textStyle="normal"
                    android:textSize="12sp"
                    android:gravity="left"
                    android:textColor="@color/dark_grey"
                    android:background="@drawable/bg_cell_row"/>

            </LinearLayout>





            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:orientation="vertical">




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="5"
                    android:layout_marginTop="0dp"
                    android:layout_marginLeft="-1dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.4"
                        android:text=""
                        android:textStyle="normal"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:textColor="@color/dark_grey"
                        android:gravity="center"
                        android:background="@drawable/bg_cell_row" >


                    </LinearLayout>


                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.8"
                        android:text=""
                        android:textStyle="normal"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/dark_grey"
                        android:layout_marginLeft="-1dp"
                        android:background="@drawable/bg_cell_row" />


                    <EditText
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.8"
                        android:text=""
                        android:textStyle="normal"
                        android:padding="8dp"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:textColor="@color/dark_grey"
                        android:layout_marginLeft="-1dp"
                        android:background="@drawable/bg_cell_row" />




                </LinearLayout>





            </LinearLayout>


        </LinearLayout>












    </LinearLayout>
</ScrollView>
