<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="0dp"
    android:layout_marginLeft="0dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardElevation="6dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <androidx.cardview.widget.CardView
                android:id="@+id/contenedorItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/color_fondo_card_inicio_conductor"
                app:cardCornerRadius="10dp"
                app:cardElevation="5dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingRight="20dp"
                    android:paddingLeft="20dp"
                    android:paddingBottom="20dp"
                    android:paddingTop="10dp">


                    <TextView
                        android:id="@+id/tvNombreFase"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Nombre fase"
                        android:textSize="12dp"
                        android:layout_gravity="right"
                        android:fontFamily="@font/robotomedium"
                        android:textColor="@color/titulo_pantalla_general" />


                    <TextView
                        android:id="@+id/tvNombreGrupo"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Nombre grupo"
                        android:textSize="16sp"
                        android:layout_gravity="center"
                        android:fontFamily="@font/robotomedium"
                        android:textColor="@color/titulo_pantalla_general"
                        android:layout_marginTop="10dp"/>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="10"
                        android:layout_marginTop="15dp">

                        <TextView
                            android:id="@+id/tvNombreActividad"
                            android:layout_width="0dp"
                            android:layout_weight="9"
                            android:layout_height="wrap_content"
                            android:text="Nombre actividad"
                            android:textSize="16sp"
                            android:layout_gravity="left"
                            android:fontFamily="@font/robotomedium"
                            android:justificationMode="inter_word"
                            android:textColor="@color/color_texto_cajatexto"
                            android:paddingRight="10dp"/>


                        <CheckBox
                            android:id="@+id/chxListo"
                            android:layout_marginTop="0dp"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/titulo_pantalla_general"
                            android:textColor="@color/texto_simple_pantalla_general" />



                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/contenedorFecha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="20dp">

                        <TextView
                            android:id="@+id/tvFechaTitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:fontFamily="@font/robotoregular"
                            android:text="Fecha cumplimiento :"
                            android:textColor="@color/titulo_pantalla_general"
                            android:textSize="14dp"
                            android:layout_gravity="left"/>

                        <TextView
                            android:id="@+id/etFecha"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_margin="0dp"
                            android:background="@android:color/transparent"
                            android:enabled="false"
                            android:text=""
                            android:textSize="15dp"
                            android:fontFamily="@font/robotoregular"
                            android:paddingStart="10dp"
                            android:paddingTop="0dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="0dp"
                            android:gravity="center|left"
                            android:textColor="@color/color_texto_cajatexto" />



                    </LinearLayout>



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/robotoregular"
                        android:text="Nombres y apellidos"
                        android:textColor="@color/titulo_pantalla_general"
                        android:textSize="14dp"
                        android:layout_gravity="left"/>

                    <RelativeLayout
                        android:id="@+id/contenedorNombreEmpleado"
                        android:layout_width="wrap_content"
                        android:layout_height="50dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/shape_text_box"
                        android:padding="0dip">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="0dp">

                            <Spinner
                                android:id="@+id/spiEmpleados"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="10dp"
                                android:background="@android:color/transparent"
                                android:paddingStart="0dp"
                                android:paddingTop="0dp"
                                android:paddingEnd="30dp"
                                android:paddingBottom="-5dp"
                                android:textColor="@color/color_texto_cajatexto"/>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:src="@drawable/ic_down"
                            android:visibility="gone"/>

                    </RelativeLayout>



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:fontFamily="@font/robotoregular"
                        android:text="Comentarios"
                        android:textColor="@color/titulo_pantalla_general"
                        android:textSize="14dp"
                        android:layout_gravity="left"/>

                    <RelativeLayout
                        android:id="@+id/contenedorComentarios"
                        android:layout_width="wrap_content"
                        android:layout_height="120dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/shape_text_box"
                        android:padding="0dip">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="0dp">

                            <EditText
                                android:id="@+id/etComentarios"
                                android:enabled="true"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="10dp"
                                android:background="@android:color/transparent"
                                android:paddingStart="10dp"
                                android:paddingTop="0dp"
                                android:paddingEnd="10dp"
                                android:hint="Ingrese comentarios"
                                android:textColorHint="@color/borde_cajatexto"
                                android:paddingBottom="-5dp"
                                android:textColor="@color/color_texto_cajatexto"
                                android:gravity="left|top"
                                android:textSize="17dp"
                                android:fontFamily="@font/robotoregular"/>

                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="10dp"
                            android:paddingTop="0dp"
                            android:paddingBottom="0dp"
                            android:src="@drawable/ic_down"
                            android:visibility="gone"/>

                    </RelativeLayout>






                </LinearLayout>




            </androidx.cardview.widget.CardView>





        </LinearLayout>


    </RelativeLayout>

</LinearLayout>